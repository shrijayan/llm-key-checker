{
  "version": 2,
  "builds": [
    {
      "src": "src/pages/api/validate.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/validators/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/validate",
      "dest": "src/pages/api/validate.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/src/pages/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
