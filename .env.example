# This file is for reference only. 
# This app has NO backend and stores NO API keys.
# All validation happens through stateless edge functions.

# The canonical URL this instance is deployed at. Drives metadataBase,
# canonical links, robots.txt, sitemap.xml, and the generated OG/Twitter
# share images. Falls back to a working placeholder if unset — set this
# once you have a real production domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: paste the "content" value Google Search Console gives you when
# verifying ownership via the HTML meta tag method. Leave unset and no
# verification tag is rendered at all (no placeholder/fake value is ever
# sent).
# GOOGLE_SITE_VERIFICATION=

